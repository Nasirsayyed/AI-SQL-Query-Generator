{
  "ConnectionStrings": {
    "ApplicationDb": ""
  },
  "Database": {
    "Initialization": "Migrate"
  },
  "Jwt": {
    "Issuer": "AIQueryGenerator",
    "Audience": "AIQueryGenerator.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "RefreshCookieSameSite": "Strict"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Limits": {
    "MaxRequestBodyBytes": 1048576
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "AiPerMinute": 20,
    "ExecutePerMinute": 30
  },
  "Execution": {
    "MaxRowsCeiling": 10000,
    "MaxCommandTimeoutSeconds": 120,
    "MaxCellLength": 4000,
    "RequireValidationToken": true,
    "ValidationTokenLifetimeMinutes": 30,
    "MaxConcurrentQueriesPerUser": 2,
    "MaxConcurrentQueriesGlobal": 20
  },
  "SqlValidation": {
    "MaxQueryLength": 20000,
    "MaxJoins": 12,
    "MaxOutputColumns": 100,
    "MaxSyntaxNodes": 5000,
    "MaxSubqueryDepth": 5,
    "MaxParameters": 25,
    "AllowSystemCatalogs": false
  },
  "Ai": {
    "MaxQuestionLength": 2000,
    "MaxRepairAttempts": 1,
    "Provider": {
      "Name": "OpenAI (configuration)",
      "ProviderType": "OpenAI",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-mini",
      "ApiKeyReference": "env:OPENAI_API_KEY",
      "Temperature": 0,
      "MaxOutputTokens": 2000,
      "TimeoutSeconds": 60,
      "MaxSchemaTables": 40
    }
  },
  "Secrets": {
    "AllowedReferencePrefixes": [ "AIQG_SECRET_", "OPENAI_API_KEY", "AZURE_OPENAI_API_KEY" ]
  },
  "DataProtection": {
    "KeysPath": "",
    "ProtectWithDpapi": false
  },
  "Seed": {
    "SuperAdmin": {
      "FullName": "Super Administrator",
      "Email": "",
      "Password": ""
    },
    "DemoConnection": {
      "Enabled": false
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/aiqg-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30, "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*"
}
