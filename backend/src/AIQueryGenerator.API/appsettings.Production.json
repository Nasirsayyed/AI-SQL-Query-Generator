{
  "Database": {
    "Initialization": "None"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "RefreshCookieSecure": true
  },
  "DataProtection": {
    "KeysPath": "D:\\AIQueryGenerator\\keys",
    "ProtectWithDpapi": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "D:\\AIQueryGenerator\\logs\\aiqg-.log", "rollingInterval": "Day", "retainedFileCountLimit": 90, "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  }
}
