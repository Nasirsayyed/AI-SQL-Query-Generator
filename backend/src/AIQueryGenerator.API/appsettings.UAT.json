{
  "Database": {
    "Initialization": "Migrate"
  },
  "Cors": {
    "AllowedOrigins": [ "https://uat.aiqg.example.com" ]
  },
  "DataProtection": {
    "KeysPath": "D:\\AIQueryGenerator\\keys",
    "ProtectWithDpapi": true
  },
