# Copy to .env.local (development) or set in the build pipeline. Never put secrets here: every VITE_* value is public.

# Base URL of the API. Leave empty when the SPA and API share an origin (recommended; the dev server proxies /api).
VITE_API_BASE_URL=
# Public path the SPA is served from ("/" or e.g. "/aiqg/").
VITE_BASE_PATH=/
# Development only: where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:5017
